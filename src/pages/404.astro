---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
	<div class="py-10">
		<h1 class="font-serif text-[2rem] font-semibold tracking-tight">Page not found</h1>
		<p class="mt-4 text-[0.95rem] text-muted">
			That page does not exist. Try the
			<a href="/projects/" class="text-ink underline decoration-accent underline-offset-4">projects</a>
			or
			<a href="/writing/" class="text-ink underline decoration-accent underline-offset-4">writing</a>
			index.
		</p>
	</div>
</Base>
