---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order
);
---

<Base title="Projects" description="Research projects in computer vision and computational analysis of architecture.">
	<PageHeader
		title="Projects"
		intro="Each project gets a long-form write-up: the question, the data, what worked and what didn't."
	/>
	<div class="grid gap-x-12 gap-y-14 lg:grid-cols-2">
		{projects.map((p) => <ProjectCard project={p} />)}
	</div>
</Base>
