---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import WritingItem from '../../components/WritingItem.astro';

const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Writing" description="Papers, technical reports, and notes.">
	<div>
		<PageHeader
			title="Writing"
			intro="Papers, technical reports, and shorter notes. Most are attached to a project."
		/>
		{
			writing.length === 0 ? (
				<p class="text-[0.9rem] text-muted">Nothing published yet.</p>
			) : (
				writing.map((w) => <WritingItem entry={w} />)
			)
		}
	</div>
</Base>
