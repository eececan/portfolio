---
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { KIND_LABEL } from '../../consts';

export const getStaticPaths = (async () => {
	const writing = await getCollection('writing', ({ data }) => !data.draft);
	return writing.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, description, date, updated, kind, authors, venue, pdf, doi } = entry.data;
const { Content, headings } = await render(entry);

const parent = entry.data.project ? await getEntry(entry.data.project) : undefined;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} description={description} ogType="article">
	<div class="xl:grid xl:grid-cols-[minmax(0,1fr)_11rem] xl:gap-x-14">
		<article class="min-w-0">
			<header class="border-b border-rule pb-8">
				<p class="mb-3 text-[0.78rem] text-faint">
					{KIND_LABEL[kind]}
					{venue && <span> &middot; {venue}</span>}
				</p>

				<h1 class="max-w-[24ch] font-serif text-[2.2rem] font-semibold leading-[1.15] tracking-tight">
					{title}
				</h1>

				<p class="mt-4 text-[0.9rem] text-muted">{authors.join(', ')}</p>
				<p class="mt-1 text-[0.8rem] tabular-nums text-faint">
					<time datetime={date.toISOString()}>{fmt(date)}</time>
					{updated && <span> &middot; updated {fmt(updated)}</span>}
				</p>

				{
					(pdf || doi || parent) && (
						<p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[0.85rem]">
							{pdf && (
								<a href={pdf} class="text-ink underline decoration-accent underline-offset-4">
									Download PDF
								</a>
							)}
							{doi && (
								<a href={`https://doi.org/${doi}`} class="text-ink underline decoration-accent underline-offset-4">
									DOI
								</a>
							)}
							{parent && (
								<a href={`/projects/${parent.id}/`} class="text-ink underline decoration-accent underline-offset-4">
									Project: {parent.data.title}
								</a>
							)}
						</p>
					)
				}
			</header>

			<div class="prose mt-12">
				<Content />
			</div>

			<p class="mt-16 text-[0.85rem]">
				<a href="/writing/" class="text-muted no-underline hover:text-ink">&larr; All writing</a>
			</p>
		</article>

		<Toc headings={headings} />
	</div>
</Base>
