---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	writingCount?: number;
}
const { project, writingCount = 0 } = Astro.props;
const { title, tagline, year, status, tags, cover, coverAlt } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="group flex flex-col">
	{
		cover && (
			<a href={href} class="block no-underline">
				<div class="overflow-hidden rounded border border-rule bg-[#1a1714]">
					<Image
						src={cover}
						alt={coverAlt ?? ''}
						widths={[400, 800, 1200]}
						sizes="(min-width: 1024px) 34vw, (min-width: 768px) 60vw, 90vw"
						class="aspect-[16/9] w-full object-cover transition-opacity group-hover:opacity-85"
					/>
				</div>
			</a>
		)
	}

	<div class="mt-4 flex items-baseline justify-between gap-4">
		<h3 class="font-serif text-[1.25rem] font-semibold leading-snug tracking-tight">
			<a href={href} class="no-underline transition-colors group-hover:text-accent">{title}</a>
		</h3>
		<span class="shrink-0 text-[0.78rem] tabular-nums text-faint">{year}</span>
	</div>

	<p class="mt-2 text-[0.9rem] leading-relaxed text-muted">{tagline}</p>

	<div class="mt-3.5 flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.73rem] text-faint">
		{status === 'active' && <span class="text-accent">In progress</span>}
		{tags.slice(0, 4).map((t) => <span class="rounded-sm bg-surface px-1.5 py-0.5">{t}</span>)}
		{writingCount > 0 && (
			<span>
				{writingCount} {writingCount === 1 ? 'writing' : 'writings'}
			</span>
		)}
	</div>
</article>
