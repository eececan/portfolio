---
import { LINKS, NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---

<aside
	class="border-b border-rule py-6 md:sticky md:top-0 md:h-screen md:self-start md:border-b-0 md:py-20"
>
	<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-4 md:block">
		<a href="/" class="font-serif text-[1.05rem] font-semibold leading-tight tracking-tight no-underline">
			{SITE.name}
		</a>

		<nav aria-label="Main" class="md:pt-8">
			<ul class="flex flex-wrap gap-x-5 gap-y-1 text-[0.85rem] md:block md:space-y-1.5">
				{
					NAV.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? 'page' : undefined}
								class:list={[
									'no-underline transition-colors hover:text-ink',
									isActive(item.href) ? 'text-ink font-medium' : 'text-muted',
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="hidden md:block md:pt-8">
			<ul class="space-y-1.5 text-[0.8rem]">
				{
					LINKS.map((l) => (
						<li>
							<a href={l.href} rel="me noopener" class="text-muted no-underline transition-colors hover:text-ink">
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</aside>
