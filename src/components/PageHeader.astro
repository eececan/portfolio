---
interface Props {
	title: string;
	intro?: string;
}
const { title, intro } = Astro.props;
---

<div class="mb-14">
	<h1 class="font-serif text-[2rem] font-semibold leading-tight tracking-tight">{title}</h1>
	{intro && <p class="mt-4 max-w-[58ch] text-[0.95rem] leading-relaxed text-muted">{intro}</p>}
</div>
