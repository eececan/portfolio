---
import type { CollectionEntry } from 'astro:content';
import { KIND_LABEL } from '../consts';

interface Props {
	entry: CollectionEntry<'writing'>;
	/** Hide the description on compact lists such as a project page. */
	compact?: boolean;
}
const { entry, compact = false } = Astro.props;
const { title, description, date, kind, venue, pdf } = entry.data;

const dateStr = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
---

<article class="border-b border-rule py-6 first:pt-0">
	<div class="flex items-baseline justify-between gap-4">
		<h3 class="font-serif text-[1.05rem] font-semibold leading-snug tracking-tight">
			<a href={`/writing/${entry.id}/`} class="no-underline transition-colors hover:text-accent">
				{title}
			</a>
		</h3>
		<time datetime={date.toISOString()} class="shrink-0 text-[0.78rem] tabular-nums text-faint">
			{dateStr}
		</time>
	</div>

	{!compact && <p class="mt-2 max-w-[60ch] text-[0.9rem] leading-relaxed text-muted">{description}</p>}

	<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] text-faint">
		<span>{KIND_LABEL[kind]}</span>
		{venue && <span>&middot; {venue}</span>}
		{
			pdf && (
				<a href={pdf} class="text-accent no-underline hover:underline">
					PDF
				</a>
			)
		}
	</div>
</article>
