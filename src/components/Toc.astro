---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
	items.length > 1 && (
		<aside class="hidden xl:block">
			<nav aria-label="Contents" class="sticky top-20">
				<p class="mb-4 text-[0.72rem] font-medium uppercase tracking-[0.12em] text-faint">Contents</p>
				<ul class="space-y-2 border-l border-rule">
					{items.map((h) => (
						<li>
							<a
								href={`#${h.slug}`}
								class="-ml-px block border-l border-transparent pl-3 text-[0.8rem] leading-snug text-muted no-underline transition-colors hover:border-accent hover:text-ink"
							>
								{h.text}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)
}
