---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	/** Cap the height and scroll inside — for very tall contact sheets. */
	tall?: boolean;
	/** Figures generated on a dark matplotlib canvas get a matching plate. */
	plate?: boolean;
}

const { src, alt, caption, tall = false, plate = true } = Astro.props;
---

<figure class="my-10">
	<div
		class:list={[
			'overflow-hidden rounded border border-rule',
			plate && 'bg-[#1a1714]',
			tall && 'max-h-[34rem] overflow-y-auto',
		]}
	>
		<Image src={src} alt={alt} class="w-full" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
