---
interface Row {
	group?: string;
	items?: string;
	label?: string;
	value?: string;
	year?: string;
}
interface Props {
	title: string;
	rows: Row[];
}
const { title, rows } = Astro.props;
---

<section class="mb-14">
	<h2 class="mb-6 text-[0.8rem] font-medium uppercase tracking-[0.12em] text-faint">{title}</h2>
	<ul class="space-y-3">
		{
			rows.map((r) => (
				<li class="grid gap-0.5 sm:grid-cols-[9.5rem_minmax(0,1fr)_auto] sm:gap-x-8">
					<span class="text-[0.8rem] text-faint">{r.group ?? r.label}</span>
					<span class="text-[0.875rem] text-muted">{r.items ?? r.value}</span>
					{r.year && <span class="text-[0.8rem] tabular-nums text-faint">{r.year}</span>}
				</li>
			))
		}
	</ul>
</section>
